# Copy this file to a new file named .env and fill in your own values.
# .env is listed in .gitignore, so it is never uploaded to GitHub. Never commit a real key.
OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=model_id_here
# 0 = use the hard-coded table (default, what the tests expect). 1 = use the model.
USE_LLM=0
